{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(index.html)?",
      "headers": [
        {
          "comment": "집회 중에 고친 내용이 바로 보이도록 현황판은 캐시하지 않습니다.",
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
