rules_version = '2';

// WELCOME HOME 초대 접수용 규칙.
// 교인들이 로그인 없이 QR만 스캔해서 제출해야 하므로 인증을 요구하지 않습니다.
// 대신 쓸 수 있는 필드와 길이를 규칙으로 묶어 아무 데이터나 못 넣게 합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    match /invites/{doc} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['name','prayer','sender','ts'])
                    && request.resource.data.name   is string
                    && request.resource.data.name.size()   > 0
                    && request.resource.data.name.size()   <= 40
                    && request.resource.data.prayer is string
                    && request.resource.data.prayer.size() > 0
                    && request.resource.data.prayer.size() <= 400
                    && request.resource.data.sender is string
                    && request.resource.data.sender.size() <= 30
                    && request.resource.data.ts     is int;

      // 잘못 보냈을 때 되돌릴 수 있게 열어둡니다.
      // 누구나 지울 수 있다는 뜻이므로, 그게 부담스러우면 false 로 바꾸고
      // 페이지의 [방금 보낸 것 취소] 버튼은 쓰지 마세요.
      allow delete: if true;
      allow update: if false;
    }

    // 목표 개수와 QR 주소. 콘솔에서만 고칩니다.
    match /config/{doc} {
      allow read:  if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
